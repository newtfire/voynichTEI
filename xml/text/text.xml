                     <graphic type="full" url="https://collections.library.yale.edu/iiif/2/1006079/full/full/0/default.jpg"/>
                     <head>Illustration on f2v</head>
                     <figDesc>Potentially <name type="inline" ref="#colocasia">Colocasia</name>,
                           <name type="inline" ref="#egyptianLotus">Egyptian Lotus</name> suggested
                        by <persName type="inline" ref="#tcp">Petersen</persName>, or <name
