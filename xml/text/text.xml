               <item xml:id="f6r_il">
                  <figure>
                     <graphic type="full" url="https://collections.library.yale.edu/iiif/2/1006086/full/full/0/default.jpg"/>
                     <head>Illustration on f6r</head>
                     <figDesc>Potentially Asclepiades, but with wrong leaves (of Pediculum)
                        suggested by <persName type="inline" ref="#tcp">Petersen</persName></figDesc>
                  </figure>
