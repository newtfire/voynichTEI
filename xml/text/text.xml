                     <head>Illustration on f6v</head>
                     <figDesc>Potentially blackgum tree?, arctium? Bidens(sp?)kyptis
                        suggested by <persName type="inline" ref="#hon">O'Neill</persName>.</figDesc>
                  </figure>
               </item>
               <item xml:id="f7r_il">
                  <figure>
                     <graphic type="full" url="https://collections.library.yale.edu/iiif/2/1006088/full/full/0/default.jpg"/>
                     <head>Illustration on f7r</head>
                     <figDesc>Potentially Nymphaea alba suggested by <persName type="inline" ref="#tcp">Petersen</persName>.</figDesc>
                  </figure>
               </item>
               <item xml:id="f7v_il">
                  <figure>
                     <graphic type="full" url="https://collections.library.yale.edu/iiif/2/1006089/full/full/0/default.jpg"/>
                     <head>Illustration on f7v</head>
                     <figDesc>Potentially polygonum persicaria, potentilla silvestris, or oculus christi suggested by <persName type="inline" ref="#tcp">Petersen</persName>.</figDesc>
                  </figure>
               </item>
            </list>
            <list sortKey="plants">
               <item xml:id="belladonna">
                  <name>Atropa Bella-Donna</name>
                  <name type="genus">Atropa</name>
                  <name type="species">Atropa bella-donna</name>
                  <name type="family">Solanaceae</name>
                  <name>
                     <addName>Belladonna</addName>
                     <addName>Deadly Nightshade</addName>
                     <addName>Divale</addName>
                     <addName>Dwale</addName>
                  </name>
                  <desc resp="#hjb">A toxic perennial herbaceous plant native to Europe, North
                     Africa, and Western Asia.</desc>
                  <note resp="#hjb">Located in <ref target="#f1v">f1v</ref>.</note>
                  <note>
                     <ptr target="https://plants.ces.ncsu.edu/plants/atropa-bella-donna/"/>
                     <ptr target="https://species.wikimedia.org/wiki/Atropa_bella-donna"/>
                     <ptr target="https://www.gbif.org/species/144096243"/>
                  </note>
               </item>
               <item xml:id="centauriumErythaea">
                  <name>Centaurium Erythaea</name>
                  <name type="genus">Centaurium</name>
                  <name type="species">Centaurium Erythraea</name>
                  <name type="family">Gentianaceae</name>
                  <name>
                     <addName>European Centaury</addName>
                     <addName>Feverwort</addName>
                  </name>
                  <desc resp="#hjb">Often found in open woods, meadows and dry grasslands</desc>
                  <note resp="#hjb">Located in <ref target="#f4r">f4r</ref>.</note>
                  <note>
                     <ptr target="https://pfaf.org/user/Plant.aspx?LatinName=Centaurium+erythraea"/>
                     <ptr target="https://species.wikimedia.org/wiki/Centaurium_erythraea"/>
                  </note>
               </item>
               <item xml:id="colocasia">
                  <name>Colocasia</name>
                  <name type="genus">Colocasia</name>
                  <name type="family">Araceae</name>
                  <name>
                     <addName>Dasheen</addName>
                     <addName>Elephant's-ear</addName>
                     <addName>Taro</addName>
                  </name>
                  <desc resp="#hjb">Plant with massive leaves originating in Southeastern
                     Asia</desc>
                  <note resp="#hjb">Located in <ref target="#f2v">f2v</ref>.</note>
                  <note>
                     <ptr target="https://species.wikimedia.org/wiki/Colocasia_Schott"/>
                     <ptr target="https://www.voynich.nu/extra/herb_oldid.html"/>
                     <ptr target="https://plants.ces.ncsu.edu/plants/colocasia/"/>
                  </note>
               </item>
               <item xml:id="cornflower">
                  <name>Cornflower</name>
                  <name type="genus">Centaurea</name>
                  <name type="species">Centaurea cyanus</name>
                  <name type="family">Asteraceae</name>
                  <name>
                     <addName>Bachelor's Button</addName>
                     <addName>Bluebottle</addName>
                  </name>
                  <desc resp="#hjb">Grow as a weed in fields. Blue flowers.</desc>
                  <note resp="#hjb">Located in <ref target="#f2r">f2r</ref>.</note>
                  <note>
                     <ptr target="https://species.wikimedia.org/wiki/Centaurea_cyanus"/>
                     <ptr target="https://www.voynich.nu/extra/herb_oldid.html"/>
                     <ptr target="https://plants.ces.ncsu.edu/plants/centaurea-cyanus/"/>
                  </note>
               </item>
               <item xml:id="cretanDittany">
                  <name>Cretan Dittany</name>
                  <name type="genus">Origanum</name>
                  <name type="species">Origanum dictamnus</name>
                  <name type="family">Lamiaceae</name>
                  <desc resp="#hjb">A bushy sub-shrub with aromatic foliage native to rocky slopes
                     on the mountains of Crete.</desc>
                  <note resp="#hjb">Located in <ref target="#f3r">f3r</ref>.</note>
                  <note>
                     <ptr target="https://species.wikimedia.org/wiki/Origanum_dictamnus"/>
                     <ptr target="https://www.voynich.nu/extra/herb_oldid.html"/>
                     <ptr
                        target="https://www.missouribotanicalgarden.org/PlantFinder/PlantFinderDetails.aspx?taxonid=281581"/>
                  </note>
               </item>
               <item xml:id="egyptianLotus">
                  <name>Egyptian Lotus</name>
                  <name type="genus">Nymphaea</name>
                  <name type="species">Nymphaea lotus</name>
                  <name type="family">Nymphaeaceae</name>
                  <name>
                     <addName>White Lotus</addName>
                  </name>
                  <desc resp="#hjb">A robust night-blooming aquatic perennial plant that floats on
                     the surface of the water. Native to Africa and specific areas of Europe.</desc>
                  <note resp="#hjb">Located in <ref target="#f2v">f2v</ref>.</note>
                  <note>
                     <ptr target="https://species.wikimedia.org/wiki/Nymphaea_lotus"/>
                     <ptr target="https://www.voynich.nu/extra/herb_oldid.html"/>
                     <ptr target="https://www.gardenia.net/plant/nymphaea-lotus"/>
                     <ptr target="https://tropical.theferns.info/viewtropical.php?id=Nymphaea+lotus"/>
                  </note>
               </item>
               <item xml:id="hypericum">
                  <name>Hypericum</name>
                  <name type="genus">Hypericum</name>
                  <name type="family">Hypericaceae</name>
                  <name>
                     <addName>St. John's Wort</addName>
                     <addName>Goatweed</addName>
                  </name>
                  <desc resp="#hjb">A genus of flowering plants.</desc>
                  <note resp="#hjb">Located in <ref target="#f4r">f4r</ref></note>
                  <note>
                     <ptr target="https://species.wikimedia.org/wiki/Hypericum"/>
                     <ptr target="https://en.wikipedia.org/wiki/Hypericum"/>
                  </note>
               </item>
               <item xml:id="nymphoidesPeltata">
                  <name>Nymphoides Peltata</name>
                  <name type="genus">Nymphoides</name>
                  <name type="species">Nymphoides peltata</name>
                  <name type="family">Menyanthaceae</name>
                  <name>
                     <addName>Yellow floating heart</addName>
                     <addName>Water-fringe</addName>
                  </name>
                  <desc resp="#hjb">A rhizomatous, floating-leaf, aquatic perennial that looks like
                     a small water lily. Native to Europe and Asia.</desc>
                  <note resp="#hjb">Located in <ref target="#f2v">f2v</ref>.</note>
                  <note>
                     <ptr target="https://species.wikimedia.org/wiki/Nymphoides_peltata"/>
                     <ptr
                        target="https://www.missouribotanicalgarden.org/PlantFinder/PlantFinderDetails.aspx?taxonid=282718&amp;isprofile=0&amp;chr=48"/>
                  </note>
               </item>
               <item xml:id="solanumNigrum">
                  <name>Solanum Nigrum</name>
                  <name type="genus">Solanum</name>
                  <name type="species">Solanum Nigrum</name>
                  <name type="family">Solanaceae</name>
                  <name>
                     <addName>Blackberry Nightshade</addName>
                     <addName>Black Nightshade</addName>
                     <addName>Common Nightshade</addName>
                     <addName>European Black Nightshade</addName>
                     <addName>Garden Nightshade</addName>
                     <addName>Poisonberry</addName>
                  </name>
                  <desc resp="#hjb">Perennial herb that is an erect and dense shrub native to parts
                     of Europe, Asia, Macaronesia, and the North and Northeast portions of
                     Africa.</desc>
                  <note resp="#hjb">Located in <ref target="#f1v">f1v</ref>.</note>
                  <note>
                     <ptr target="https://species.wikimedia.org/wiki/Solanum_nigrum"/>
                     <ptr target="https://plants.ces.ncsu.edu/plants/solanum-nigrum/"/>
                  </note>
               </item>
               <item xml:id="unknown">
                  <name>Unknown</name>
                  <desc resp="#hjb">This is when a plant is not identified.</desc>
               </item>
            </list>
         </div>
